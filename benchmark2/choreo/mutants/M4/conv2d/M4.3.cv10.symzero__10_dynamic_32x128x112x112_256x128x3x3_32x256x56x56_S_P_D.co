#include "choreo.h"
#include "common.h"

__co__ auto CONV2D(f32 [8, 128, 16, 16] i, f32 [256, 128, 3, 3] w, int stride, int padding, int dilation) {
  N = i.span(0);
  Cin = i.span(1);
  H = i.span(2);
  W = i.span(3);
  Cout = w.span(0);
  Kh = w.span(2);
  Kw = w.span(3);
  Hpad = H + 2 * padding;
  Wpad = W + 2 * padding;
  Ho = (Hpad - dilation * (Kh - 1) - 1) / stride + 1;
  Wo = (Wpad - dilation * (Kw - 1) - 1) / stride + 1;

  f32 [N, Cout, Ho, Wo] o;

  parallel p by 2  {
    parallel q by 4  {
      foreach {co, n} in [Cout, N - N] {
        shared f32 [Ho, Wo] Y{0.0f};
        foreach ci in [Cin] {
          il = dma.pad<{0, 0, padding, padding}, {0, 0, padding, padding}, {0, 0, 0, 0}, 0.0f> i.chunkat(p#q#n, ci, _, _) => shared;
          ws = dma.copy w.chunkat(co, ci, _, _) => shared;
          foreach {ho, wo} in [Ho, Wo] {
            f32 sum = 0.0f;
            foreach {hw, ww} in [Kh, Kw] {
              hi = ho * stride + hw * dilation;
              wi = wo * stride + ww * dilation;
              sum += il.data.at(0, 0, hi, wi) * ws.data.at(0, 0, hw, ww);
            }
            Y.at(ho, wo) += sum;
          }
        }
        dma.copy Y.span_as(1, 1, Ho, Wo) => o.chunkat(p#q#n, co, _, _);
      }
    }
  }
  return o;
}

int main() {
  test_dynamic("CONV2D", CONV2D, {8, 128, 16, 16}, {256, 128, 3, 3}, 2, 1, 1);
}
