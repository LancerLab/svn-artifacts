#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define attn_h 4
#define attn_w 4
#endif

#define stride 1
#define padding 0
#define dilation 1

#define MT 16
#define CT 64
#define KT 8

__co__ auto CONV2D(f32 [32, 512, attn_h, attn_w] i, f32 [1024, 512, 1, 1] w) {
  N = i.span(0);
  Cin = i.span(1);
  H = i.span(2);
  W = i.span(3);
  Cout = w.span(0);
  Kh = w.span(2);
  Kw = w.span(3);
  Ho = (H + 2 * padding - dilation * (Kh - 1) - 1) / stride + 1;
  Wo = (W + 2 * padding - dilation * (Kw - 1) - 1) / stride + 1;
  Hpad = H + 2 * padding;
  Wpad = W + 2 * padding;

  f32 [N, Cout, Ho, Wo] o;

  M = Ho * Wo;
  K = Cin * Kh * Kw;

  // Cooperative shared-memory GEMM:
  //   - The full weight matrix B[Cout, K] (2 MB here) does NOT fit in shared.
  //     Instead a [CT, KT] block-tile is streamed global->shared per K-tile and
  //     Cout-tile, and each thread accumulates a [MT, CT] output tile in local.
  //   - The im2col operand A is streamed global->shared as [KT, MT] K-tiles.
  //   - The inner product is indexed (`.at`), so the streamed shared tiles keep
  //     their strided layouts; a raw-pointer dot would read the wrong elements.
  parallel p by 2  {
    foreach n in [N / #p] {
      parallel q by 1  {
        foreach ct in [Cout / CT] {
          local f32 [MT, CT] l1_Y{0.0f};
          shared f32 [CT, KT] B_tile;
          shared f32 [KT, MT] l1_A;
          foreach kt in [K / KT] {
            dma.copy w.span_as(Cout, K).chunkat(ct, kt + 1) => B_tile;
            dma.copy i.chunkat(p#n, _, _, _).span_as(K, Ho, Wo).chunkat(kt, q, _).span_as(KT, MT) => l1_A;
            foreach {mm, co} in [MT, CT] {
              foreach kk in [KT] {
                l1_Y.at(mm, co) += l1_A.at(kk, mm) * B_tile.at(co, kk);
              }
            }
          }
          dma.transp<1, 0> l1_Y => o.chunkat(p#n, ct, q, _).span_as(CT, MT);
        }
      }
    }
  }
  return o;
}

int main() {
  test("CONV2D", CONV2D, {32, 512, 4, 4}, {1024, 512, 1, 1}, 1, 0, 1);
}
