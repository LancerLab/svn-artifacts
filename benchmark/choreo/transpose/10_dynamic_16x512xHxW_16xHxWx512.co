#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define scale_h 64
#define scale_w 64
#endif

__co__ auto TRANSPOSE(f32 [16, 512, scale_h, scale_w] i) {
  f32 [i.span(0), i.span(2), i.span(3), i.span(1)] o;
  parallel p by 16 : block {
    foreach {y, z, w} in [512, scale_h, scale_w]
      o.at(p, z, w, y) = i.at(p, y, z, w);
  }
  return o;
}

int main() {
  test4("TRANSPOSE", TRANSPOSE, {16, 512, 64, 64}, {0, 2, 3, 1});
}
