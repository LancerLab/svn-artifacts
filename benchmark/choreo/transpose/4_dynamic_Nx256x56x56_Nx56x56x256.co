#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define batch_size 32
#endif

__co__ auto TRANSPOSE(f32 [batch_size, 256, 56, 56] i) {
  f32 [i.span(0), i.span(2), i.span(3), i.span(1)] o;
  parallel p by batch_size : block {
    foreach {y, z, w} in [256, 56, 56]
      o.at(p, z, w, y) = i.at(p, y, z, w);
  }
  return o;
}

int main() {
  test4("TRANSPOSE", TRANSPOSE, {32, 256, 56, 56}, {0, 2, 3, 1});
}
