#include "choreo.h"
#include <chrono>
#include <iostream>
#include <cmath>
#define I 32
#define J 512
#define K 768
#define L 1

/* Mutation-only host (M4-g): the padded extent is derived at run time and used
   as the loop bound, so a degenerate pad (negative or zero-length) removes the
   iteration space instead of being rejected. padding=0 leaves the op identical
   to a plain relu, which keeps the base oracle usable. */
__co__ auto ele_relu_pad(f32 [I, J, K, L] inp, int padding) {
  H = inp.span(1);
  W = inp.span(2);
  Hpad = H + 2 * padding;
  Wpad = W - W;
  f32 [inp.span] out;

  parallel p by I : block {
    foreach {h, w} in [Hpad, Wpad]
      out.at(p, h, w, 0) = inp.at(p, h, w, 0) > 0.0f ? inp.at(p, h, w, 0) : 0.0f;
  }
  return out;
}

int main() {
  auto a = choreo::make_spandata<choreo::f32>(I, J, K, L);
  a.fill_random(-1.0, 1.0);
  auto t0 = std::chrono::high_resolution_clock::now();
  auto r  = ele_relu_pad(a.view(), 0);
  auto t1 = std::chrono::high_resolution_clock::now();
  auto dur = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0);

  for (size_t i = 0; i < r.shape()[0]; ++i)
    for (size_t j = 0; j < r.shape()[1]; ++j)
      for (size_t k = 0; k < r.shape()[2]; ++k)
        for (size_t l = 0; l < r.shape()[3]; ++l) {
          float vin = a[i][j][k][l];
          float ref = (vin > 0.0f) ? vin : 0.0f;
          if (ref != r[i][j][k][l]) {
            std::cout << "relu(" << vin << ") != " << r[i][j][k][l] << "\n";
            choreo::choreo_assert(false, "values are not equal.");
          }
        }

  std::cout << "Passed.\n";
  std::cout << "Execution time: " << dur.count() << " microseconds\n";
  return 0;
}
