#include "choreo.h"
float* conv2d_cpu(const float* input, const float* weight,
                  int N, int Cin, int H, int W, int Cout, int Kh, int Kw,
                  int stride, int padding, int dilation) {
  int Ho = (H + 2 * padding - dilation * (Kh - 1) - 1) / stride + 1;
  int Wo = (W + 2 * padding - dilation * (Kw - 1) - 1) / stride + 1;
  float* output = new float[N * Cout * Ho * Wo];
  for (int n = 0; n < N; n++)
    for (int co = 0; co < Cout; co++)
      for (int ho = 0; ho < Ho; ho++)
        for (int wo = 0; wo < Wo; wo++) {
          float sum = 0.0f;
          for (int ci = 0; ci < Cin; ci++)
            for (int kh = 0; kh < Kh; kh++)
              for (int kw = 0; kw < Kw; kw++) {
                int h_in = ho * stride - padding + kh * dilation;
                int w_in = wo * stride - padding + kw * dilation;
                if (h_in >= 0 && h_in < H && w_in >= 0 && w_in < W)
                  sum += input[((n * Cin + ci) * H + h_in) * W + w_in] *
                         weight[((co * Cin + ci) * Kh + kh) * Kw + kw];
              }
          output[((n * Cout + co) * Ho + ho) * Wo + wo] = sum;
        }
  return output;
}


#ifdef __STATIC_SHAPE__
#define attn_h 4
#define attn_w 4
#endif

#define stride 1
#define padding 0
#define dilation 1

#define MT 16
#define CT 64
#define KT 8

__co__ auto conv1s(f32 [32, 512, attn_h, attn_w] i, f32 [1024, 512, 1, 1] w) {
  N = i.span(0);
  Cin = i.span(1);
  H = i.span(2);
  W = i.span(3);
  Cout = w.span(0);
  Kh = w.span(2);
  Kw = w.span(3);
  Ho = (H + 2 * padding - dilation * (Kh - 1) - 1) / stride + 1;
  Wo = (W + 2 * padding - dilation * (Kw - 1) - 1) / stride + 1;
  Hpad = H + 2 * padding;
  Wpad = W + 2 * padding;

  f32 [N, Cout, Ho, Wo] o;

  M = Ho * Wo;
  K = Cin * Kh * Kw;

  // Cooperative shared-memory GEMM:
  //   - The full weight matrix B[Cout, K] (2 MB here) does NOT fit in shared.
  //     Instead a [CT, KT] block-tile is streamed global->shared per K-tile and
  //     Cout-tile, and each thread accumulates a [MT, CT] output tile in local.
  //   - The im2col operand A is streamed global->shared as [KT, MT] K-tiles.
  //   - The inner product is indexed (`.at`), so the streamed shared tiles keep
  //     their strided layouts; a raw-pointer dot would read the wrong elements.
  parallel p by 2  {
    foreach n in [N / #p] {
      parallel q by 1  {
        foreach ct in [Cout / CT] {
          local f32 [MT, CT] l1_Y{0.0f};
          shared f32 [CT, KT] B_tile;
          shared f32 [KT, MT] l1_A;
          foreach kt in [K / KT] {
            dma.copy w.span_as(Cout, K).chunkat(ct, kt) => B_tile;
            dma.copy i.chunkat(p#n, _, _, _).span_as(K, Ho, Wo).chunkat(kt, q, _).span_as(KT, MT) => l1_A;
            foreach {mm, co} in [MT, CT] {
              foreach kk in [KT] {
                l1_Y.at(mm, co) += l1_A.at(kk, mm) * B_tile.at(co, kk);
              }
            }
          }
          dma.transp<1, 0> l1_Y => o.chunkat(p#n, ct, q, _).span_as(CT, MT);
        }
      }
    }
  }
  return o;
}

int main() {
  auto input = choreo::make_spandata<choreo::f32>(32, 512, 4, 4);
  auto kernel = choreo::make_spandata<choreo::f32>(1024, 512, 1, 1);
  input.fill_random(-1.0f, 1.0f);
  kernel.fill_random(-1.0f, 1.0f);

  auto t0 = std::chrono::high_resolution_clock::now();
  auto res = conv1s(input.view(), kernel.view());
  auto t1 = std::chrono::high_resolution_clock::now();
  auto dur = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0);

  auto ref = conv2d_cpu(input.data(), kernel.data(), 32, 512, 4, 4, 1024, 1, 1,
                        1, 0, 1);
  size_t idx = 0;
  for (int n = 0; n < 32; ++n)
    for (int co = 0; co < 1024; ++co)
      for (int h = 0; h < 4; ++h)
        for (int w = 0; w < 4; ++w, ++idx) {
          float a = res[n][co][h][w];
          float e = ref[idx];
          if (fabs(a - e) > 1e-2f &&
              fabs(a - e) > 1e-1f * std::max(fabs(a), fabs(e))) {
            std::cout << "conv1s mismatch\n";
            choreo::choreo_assert(false, "values are not equal.");
          }
        }
  delete[] ref;

  std::cout << "Passed.\n";
  std::cout << "Execution time: " << dur.count() << " microseconds\n";
  return 0;
}
