#include "common.hpp"
#ifdef __STATIC_SHAPE__
#define seq_len 128
#endif

// case11: [32, seq_len, 768] --> [32, seq_len, 768] (Dynamic)
__co__ auto softmax11(f32 [32, seq_len, 768] input) {
  f32 [input.span(0), input.span(1), input.span(2)] output;
  // The reduction runs over the 768 feature dim, so seq_len can be split
  // across the block. Each of the 8x8 lanes owns seq_len/64 rows, so a lane's
  // tile is seq_len/64 * 768 * 4 bytes; the tile is staged cooperatively in
  // shared memory and the row is normalized in place, so the single live
  // buffer costs (seq_len/8)*768*4 = 49 KB at seq_len=128, well within the
  // on-chip scratchpad budget.
  parallel p by 8, q by 8 {
    foreach {i} in [input.span(0)] {
      l1_input = dma.copy input.chunkat(i, p#q, _) => shared;
      foreach {j} in [l1_input.span(1)] {
        // Find max for numerical stability
        f32 max_val = l1_input.data.at(0, j, 0);
        foreach {k} in [l1_input.span(2)]
          if (l1_input.data.at(0, j, k) > max_val)
            max_val = l1_input.data.at(0, j, k);

        // Compute exp and sum
        f32 sum_exp = 0.0f;
        foreach {k} in [l1_input.span(2)] {
          l1_input.data.at(0, j, k) = __exp(l1_input.data.at(0, j, k) - max_val);
          sum_exp += l1_input.data.at(0, j, k);
        }

        // Normalize
        foreach {k} in [l1_input.span(2)]
          l1_input.data.at(0, j, k) = l1_input.data.at(0, j, k) / sum_exp;
      }
      dma.copy l1_input => output.chunkat(i + 1, p#q, _);
    }
  }
  return output;
}

int main() {
  TEST1(softmax11, 32, 128, 768);
  return 0;
}
