#include "common.hpp"
#ifdef __STATIC_SHAPE__
#define S 512
#endif
// case11: [32, S, 768] + [768, 768] --> [32, S, 768] (Dynamic)
__co__ auto matmul11(f32 [32, S, 768] lhs, f32 [768, 768] rhs) {
  f32 [lhs.span(0), lhs.span(1), rhs.span(1)] output;
  // [1, 6, 6] tiles leave l1_out and l1_a at 1*S*128*4 = 256 KB each (S=512),
  // 576 KB per thread in total, over the 256 KB CUDA local-memory ceiling.
  // [1, 32, 32] -- the tiling already used by case 9 -- gives 48 KB each plus
  // a 2 KB rhs tile, ~98 KB per thread.
  parallel p by 4, q by 8 {
    with index = {m_tile, n_tile, k_tile} in [1, 32, 32] {
      foreach m_tile, n_tile {
        local f32[output.span(0)/#p/#q, output.span(1)/#m_tile, output.span(2)/#n_tile] l1_out {0.0f};
        foreach k_tile {
          l1_a = dma.copy lhs.chunkat(p#q, m_tile, k_tile) => local;
          l1_b = dma.transp<1,0> rhs.chunkat(k_tile, n_tile + 1) => local;
          foreach {i} in [l1_out.span(0)] {
            call k_matmul(l1_a.chunkat(i,_,_), l1_b.data, l1_out, l1_a.span(1), l1_b.span(0), l1_a.span(2));
          }
        }
        dma.copy l1_out => output.chunkat(p#q, m_tile, n_tile);
      }
    }
  }
  return output;
}

int main() {
  TEST2(matmul11, 32, 512, 768, 768);
  return 0;
}