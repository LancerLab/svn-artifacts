  "S12_method": {
    "tool": "LLVM AddressSanitizer (native, host CPU)",
    "chain": "mlir-opt <bare pipeline> | mlir-translate --mlir-to-llvmir | patch sanitize_address + target triple/datalayout | opt -passes=asan | clang -fsanitize=address",
