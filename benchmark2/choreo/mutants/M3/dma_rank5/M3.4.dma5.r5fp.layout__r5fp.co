#include "common.hpp"
#include "choreo.h"
#include <chrono>
#include <iostream>

__co__ auto r5fp(f32 [256,N,256,256,2] input) {
  f32 [N,256,256,2,256] output;
  parallel p by 1 : block
    parallel q by 32 : thread {
      dma.transp<1,2,3,4,0> input => output;
    }
  return output;
}

int main() {
  int N = 1;
  auto src = choreo::make_spandata<choreo::f32>(256, N, 256, 256, 2);
  src.fill_random(-1.0, 1.0);

  auto t0 = std::chrono::high_resolution_clock::now();
  auto r = r5fp(src.view());
  auto t1 = std::chrono::high_resolution_clock::now();

  {
    const int expect[5] = {1, 128, 256, 2, 256};
    for (int i = 0; i < 5; ++i)
      choreo::choreo_assert((int)r.shape()[i] == expect[i],
                            "M3.4: output extent contract violated");
  }
  auto dur = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0);

  for (int n = 0; n < (int)r.shape()[0]; ++n)
    for (int c = 0; c < (int)r.shape()[1]; ++c)
      for (int d = 0; d < (int)r.shape()[2]; ++d)
        for (int e = 0; e < (int)r.shape()[3]; ++e)
          for (int m = 0; m < (int)r.shape()[4]; ++m) {
            float ref = src[m][n][c][d][e];
            if (ref != r[n][c][d][e][m]) {
              std::cout << "r5fp(" << ref << ") != " << r[n][c][d][e][m]
                        << "\n";
              choreo::choreo_assert(false, "values are not equal.");
            }
          }

  std::cout << "Passed.\n";
  std::cout << "Execution time: " << dur.count() << " microseconds\n";
  return 0;
}
