#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define attn_h 4
#define attn_w 4
#endif

#define stride 1
#define padding 0
#define dilation 1

__co__ auto CONV2D(f32 [128, C, 112, 112] i, f32 [64, C, 1, 1] w) {
  N = i.span(0);
  Cin = i.span(1);
  H = i.span(2);
  W = i.span(3);
  Cout = w.span(0);
  Kh = w.span(2);
  Kw = w.span(3);
  Ho = (H + 2 * padding - dilation * (Kh - 1) - 1) / stride + 1;
  Wo = (W + 2 * padding - dilation * (Kw - 1) - 1) / stride + 1;
  Hpad = H + 2 * padding;
  Wpad = W + 2 * padding;

  f32 [N, Cout, Ho, Wo] o;

  M = Ho * Wo;
  K = Cin * Kh * Kw;

  // Cooperative shared-memory tiling (standard GPU GEMM pattern):
  //   - Only the weight matrix B[Cout, K] lives in shared; the threads of each
  //     parallel-by level cooperatively fill and reuse those shared slots.
  //     Here B is small (Cout x C), so it fits well within the 48 KB safe limit.
  //   - The previous version also materialised A[M, K] (~1.6 MB) and Y[M, Cout]
  //     (~3.2 MB) in shared, which blew past the limit. A is now streamed
  //     global->local per tile and Y is accumulated in local, written straight
  //     to global.
  parallel p by 2  {
    B = dma.copy w.span_as(Cout, K) => shared;

    foreach n in [N / #p] {
      // GEMM: C = A x B, result shape: M x Cout
      parallel q by 16  {
        foreach {qq} in [#q] {
          local f32 [M/#q, Cout/#qq] l1_Y{0.0f};
          l1_A = dma.copy i.chunkat(p#n, _, _, _).span_as(K, Ho, Wo).chunkat(_, q, _).span_as(K, M/#q) => local;
          l1_B = dma.copy B.chunkat(qq, _) => local;
          call k_matmul(l1_A.data, l1_B.data, l1_Y, M/#q, Cout/#qq, K);
          dma.transp<1, 0> l1_Y => o.chunkat(p#n, qq, q, _).span_as(Cout/#qq, M/#q);
        }
      }
    }
  }
  return o;
}

int main() {
  test("CONV2D", CONV2D, {128, 32, 112, 112}, {64, 32, 1, 1}, 1, 0, 1);
}