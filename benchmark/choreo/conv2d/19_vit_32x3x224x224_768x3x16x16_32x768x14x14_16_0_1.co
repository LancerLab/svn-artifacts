#include "choreo.h"
#include "common.h"

#define stride 16
#define padding 0
#define dilation 1

#define CT 16
#define KT 16

__co__ auto CONV2D(f32 [32, 3, 224, 224] i, f32 [768, 3, 16, 16] w) {
  N = i.span(0);
  Cin = i.span(1);
  H = i.span(2);
  W = i.span(3);
  Cout = w.span(0);
  Kh = w.span(2);
  Kw = w.span(3);
  Ho = (H + 2 * padding - dilation * (Kh - 1) - 1) / stride + 1;
  Wo = (W + 2 * padding - dilation * (Kw - 1) - 1) / stride + 1;
  Hpad = H + 2 * padding;
  Wpad = W + 2 * padding;

  f32 [N, Cout, Ho, Wo] o;

  M = Ho * Wo;
  K = Cin * Kh * Kw;

  // Cooperative shared-memory GEMM (patchify path, stride = Kh = 16):
  //   - K = Cin*Kh*Kw = 768 does not fit in shared whole: the previous
  //     A[14,768] + B[16,768] staging replicated per q-thread ran to 636 KB
  //     per block.  K is streamed global->shared in 48 chunks of KT = Kw = 16
  //     instead, and each thread accumulates its [14, CT] output tile in local.
  //   - K-chunk (c, kh) is the flat-k slice [c*Kh*Kw + kh*Kw, +16): contiguous
  //     in BOTH operands (one row of the w view, one image row of the patch),
  //     so no dma view needs to merge strided dims (span_as only ever merges
  //     contiguous or extent-1 dims).
  //   - The inner product is indexed (`.at`), so the streamed shared tiles
  //     keep their strided layouts; a raw-pointer dot would read the wrong
  //     elements.
  parallel p by 2  {
    foreach n in [N / #p] {
      parallel q by 14  {
        foreach {cot} in [48] {
          local f32 [14, CT] l1_Y{0.0f};
          shared f32 [14, KT] A_tile;
          shared f32 [CT, KT] B_tile;
          foreach {cc, hh} in [Cin, Kh] {
            dma.copy w.span_as(Cout, K).chunkat(cot, cc#hh) => B_tile;
            with {x, y} in [Ho/14, Wo] {
              foreach x, y {
                dma.copy i.chunkat(p#n, _, q#x, y).chunkat(_, cc, hh, _).span_as(1, Kw) => A_tile.chunkat(y, _);
              }
            }
            foreach {m, co} in [14, CT] {
              foreach kk in [KT] {
                l1_Y.at(m, co) += A_tile.at(m, kk) * B_tile.at(co, kk);
              }
            }
          }
            dma.transp<0, 3, 2, 1> l1_Y.span_as(1, 14, 1, CT) => o.chunkat(p#n, cot, q, _);
        }
      }
    }
  }
  return o;
}

int main() {
  test("CONV2D", CONV2D, {32, 3, 224, 224}, {768, 3, 16, 16}, 16, 0, 1);
}
