#include "common.hpp"
#ifdef __STATIC_SHAPE__
#define V 256
#endif
// case13: [32, 512, V] + [V, 768] --> [32, 512, 768] (Dynamic)
__co__ auto matmul13(f32 [32, 512, V] lhs, f32 [V, 768] rhs) {
  f32 [lhs.span(0), lhs.span(1), rhs.span(1)] output;
  // Group tile buffers live in shared memory (one on-chip copy per group),
  // the same pattern as the static cases (e.g. case15).  [32, 32, 8] tiling
  // keeps the per-thread tiles small (l1_out 1.5 KB, l1_a 2 KB, l1_b 3 KB at
  // V=256) so no dynamic-size buffer lands in per-thread local memory.
  parallel p by 4, q by 8 {
    with index = {m_tile, n_tile, k_tile} in [32, 32, 8] {
      foreach m_tile, n_tile {
        shared f32[output.span(0)/#p/#q, output.span(1)/#m_tile, output.span(2)/#n_tile] l1_out {0.0f};
        foreach k_tile {
          l1_a = dma.copy lhs.chunkat(p#q, m_tile, k_tile) => shared;
          l1_b = dma.transp<1,0> rhs.chunkat(k_tile, n_tile) => shared;
          foreach {i} in [l1_out.span(0)] {
            call k_matmul(l1_a.chunkat(i,_,_), l1_b.data, l1_out, l1_a.span(1), l1_b.span(0), l1_a.span(2));
          }
        }
        dma.copy l1_out => output.chunkat(p#q, m_tile, n_tile);
      }
    }
  }
  return output;
}

int main() {
  TEST2(matmul13, 32, 512, 768, 256);
  return 0;
}